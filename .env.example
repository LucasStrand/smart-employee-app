# Copy to `.env` (never commit `.env`).

# Neon Postgres — used by app/(api) routes
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Microsoft Entra ID (public client)
EXPO_PUBLIC_AZURE_CLIENT_ID=
EXPO_PUBLIC_AZURE_TENANT_ID=

# Microsoft Graph
EXPO_PUBLIC_GRAPH_API=https://graph.microsoft.com/v1.0

# Optional
EXPO_PUBLIC_SERVER_URL=https://smartteknik.nu/
EXPO_PUBLIC_SUPPORT_EMAIL=info@smartteknik.nu
EXPO_PUBLIC_NEXT_API_URL=
EXPO_PUBLIC_NEXT_TOKEN=
